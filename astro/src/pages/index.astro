---
/**
 * Hub — / route.
 *
 * Renders the `index` collection entry as the homepage: title
 * "Competent – Uživatelská příručka" + intro + three Diataxis
 * cards (Návody / Slovník pojmů / Koncepty via HomeCards) rendered
 * from the MDX Content.
 */

import { getEntry } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';

const entry = await getEntry('docs', 'index');

if (!entry) {
  throw new Error('Missing docs collection entry: index');
}

const { Content } = await entry.render();
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <Content />
</DocsLayout>
