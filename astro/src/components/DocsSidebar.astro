---
/**
 * DocsSidebar — static left nav. Section headers + items.
 * Active state derives from Astro.url.pathname.
 *
 * PHASE 1: DOCS_NAV sections are empty (no migrated pages yet), so the
 * sidebar renders section headers only. Items appear in phase 2.
 */

import { DOCS_NAV, DOC_CATEGORIES } from '../data/docNav';

const pathname = Astro.url.pathname;
// BASE_URL končí lomítkem ("/competent-documentation/"); sidebar routes
// jsou bez base — pro active-match ji z pathname odřízneme. Na root
// deployi (BASE_URL="/") se nekyvne ničeho.
const siteBase = import.meta.env.BASE_URL;
const barePath =
  siteBase !== '/' && pathname.startsWith(siteBase)
    ? pathname.slice(siteBase.length - 1)
    : pathname;

function withBase(route: string): string {
  return siteBase === '/' ? route : `${siteBase.slice(0, -1)}${route}`;
}

function isActive(route: string): boolean {
  if (route === '/') return barePath === '/' || barePath === '';
  const norm = barePath.endsWith('/') ? barePath : barePath + '/';
  return norm === route;
}
---

<nav class="docs-sidebar" aria-label="Dokumentace — sekce">
  {DOCS_NAV.map((section) => (
    <div class="docs-sidebar-section">
      <span class="docs-sidebar-label">{section.section}</span>
      <ul class="docs-sidebar-list">
        {section.items.map((item) => {
          const active = isActive(item.route);
          const catColor = item.category
            ? DOC_CATEGORIES[item.category].color
            : 'var(--amber)';
          return (
            <li>
              <a
                href={withBase(item.route)}
                class="docs-sidebar-link"
                aria-current={active ? 'page' : undefined}
                style={active ? `--docs-cat-color: ${catColor};` : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
