---
/**
 * DocsTOC — "Na této stránce" rail. Převzato z talkide-docs.
 * IntersectionObserver scrollspy (h2/h3), aktivní položka proti
 * 2px levému pravidlu (brand purple).
 */

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: TocHeading[];
}

const { headings = [] } = Astro.props;
const visible = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{visible.length > 0 && (
  <aside class="docs-toc" aria-label="Na této stránce" data-pagefind-ignore>
    <span class="docs-toc-label">Na této stránce</span>
    <ul class="docs-toc-list">
      {visible.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class={`docs-toc-link lvl-${h.depth}`}
            data-toc-slug={h.slug}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.docs-toc-link'),
  );
  if (links.length > 0) {
    const bySlug = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => {
      const slug = l.getAttribute('data-toc-slug');
      if (slug) bySlug.set(slug, l);
    });

    const targets = Array.from(bySlug.keys())
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    function setActive(slug: string) {
      links.forEach((l) =>
        l.setAttribute(
          'data-active',
          l.getAttribute('data-toc-slug') === slug ? 'true' : 'false',
        ),
      );
    }

    if (targets.length > 0) {
      const seen = new Set<string>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) seen.add(entry.target.id);
            else seen.delete(entry.target.id);
          }
          const firstVisible = targets.find((t) => seen.has(t.id));
          if (firstVisible) setActive(firstVisible.id);
        },
        { rootMargin: '-56px 0px -70% 0px', threshold: 0 },
      );
      targets.forEach((t) => observer.observe(t));
      setActive(targets[0].id);
    }
  }
</script>

<style>
  .docs-toc {
    position: sticky;
    top: 76px;
    align-self: start;
    max-height: calc(100vh - 96px);
    overflow: auto;
    font-size: 13px;
  }
  .docs-toc-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-3);
    margin-bottom: 8px;
  }
  .docs-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line-1);
  }
  .docs-toc-link {
    display: block;
    padding: 3px 0 3px 12px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--fg-3);
    text-decoration: none;
    line-height: 1.45;
  }
  .docs-toc-link.lvl-3 {
    padding-left: 24px;
  }
  .docs-toc-link:hover {
    color: var(--fg-1);
  }
  .docs-toc-link[data-active='true'] {
    border-left-color: var(--competent-purple);
    color: var(--fg-1);
  }
</style>
